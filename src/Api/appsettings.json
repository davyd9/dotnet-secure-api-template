{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "DotnetSecureApi",
    "Audience": "DotnetSecureApi.Users",
    "Secret": "YOUR_SUPER_SECRET_KEY_REPLACE_IN_PRODUCTION",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}
